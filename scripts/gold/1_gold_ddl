    first_30d_features_count  INT,
    used_upi                  BIT,
    used_billpay              BIT,
    used_investments          BIT,
    used_creditscore          BIT,
    used_loans                BIT,
    used_cards                BIT,
    used_budgeting            BIT,  
    total_usage_count         INT,
    txn_count                 INT,
    refund_count              INT,
    net_txn_amount            DECIMAL(16,2),
    total_revenue             DECIMAL(14,2),   
    last_active_date          DATE,
