GO

IF OBJECT_ID('gold.cohort_retention', 'U') IS NOT NULL DROP TABLE gold.cohort_retention;
GO

CREATE TABLE gold.cohort_retention (
    cohort_month          DATE,
    period_number         INT,
    cohort_users_observed INT,
    active_users          INT,
    retention_pct         DECIMAL(7,4),
    CONSTRAINT PK_gold_cohort_retention PRIMARY KEY (cohort_month, period_number)
