DROP VIEW IF EXISTS gold.valid_revenue
GO

CREATE OR ALTER VIEW gold.valid_revenue AS
SELECT r.*
FROM silver.revenue r
JOIN silver.users u ON u.user_id = r.user_id
WHERE r.year_month >= CONVERT(CHAR(7), u.signup_date, 126)
  AND r.year_month <= (SELECT CONVERT(CHAR(7), MAX(usage_date), 126) FROM silver.feature_usage);
GO 


IF OBJECT_ID('gold.user_feature', 'U') IS NOT NULL 
	DROP TABLE gold.user_feature;
GO

CREATE TABLE gold.user_feature (
    user_id              INT           NOT NULL,
    feature_name         NVARCHAR(50)  NOT NULL,
    first_used_date      DATE          NULL,      -- NULL for rows which are only in revenue
    last_used_date       DATE          NULL,
    days_to_adopt        INT           NULL,      -- first_used_date - signup_date
    adopted_in_first_30d BIT           NOT NULL,
    total_usage_count    INT           NOT NULL,
    active_usage_days    INT           NOT NULL,
    total_revenue        DECIMAL(14,2) NOT NULL,
    has_usage_record     BIT           NOT NULL,
    CONSTRAINT PK_gold_user_feature PRIMARY KEY (user_id, feature_name)
);

IF OBJECT_ID('gold.user_master', 'U') IS NOT NULL 
    DROP TABLE gold.user_master;
GO

